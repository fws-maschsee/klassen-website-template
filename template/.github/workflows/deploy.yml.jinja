name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

{% raw %}
permissions:
  contents: write
  packages: write

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

env:
  IMAGE: ghcr.io/{% endraw %}{{ github_org }}{% raw %}/{% endraw %}{{ repo_name }}{% raw %}

jobs:
  # Ein Job, weil es nur eine Architektur gibt: jeder weitere Job würde eigens auf volle Minuten aufgerundet. Für eine
  # zweite Architektur Bauen bis Push per Digest wieder als Matrix über native Runner abspalten und das Manifest in
  # einem Folgejob aus allen Digests erzeugen.
  deploy:
    if: github.ref == 'refs/heads/main'
{% endraw %}{% if target_arch == 'arm64' %}
    runs-on: ubuntu-24.04-arm # nativ, nie QEMU
{% else %}
    runs-on: ubuntu-latest # nativ, nie QEMU
{% endif %}{% raw %}
    timeout-minutes: 30
    env:
      PLATFORM: linux/{% endraw %}{{ target_arch }}{% raw %}
      ARCH: {% endraw %}{{ target_arch }}{% raw %}
    steps:
      - uses: actions/checkout@v5

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to ghcr.io
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build for local verification
        uses: docker/build-push-action@v6
        with:
          context: .
          load: true
          tags: ${{ env.IMAGE }}:verify
          platforms: ${{ env.PLATFORM }}

      - name: Verify image architecture
        run: |
          GEBAUT=$(docker image inspect "${IMAGE}:verify" --format '{{.Architecture}}')
          echo "architecture: $GEBAUT"
          [ "$GEBAUT" = "$ARCH" ] || {
            echo "::error::expected $ARCH, got $GEBAUT"; exit 1; }

      - name: Smoke test the image
        run: |
          # Wie im Cluster: non-root, read-only rootfs; /data muss beschreibbar sein, sonst scheitert dbmate.
          docker run -d --name smoke \
            --user 1000:1000 --read-only --tmpfs /tmp --tmpfs /data \
            -p 3000:3000 "${IMAGE}:verify"
          CODE=000
          for _ in $(seq 1 30); do
            # Nur `|| true`: curl gibt selbst 000 aus, ein `|| echo 000` ergäbe 000000.
            CODE=$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/ || true)
            [ "$CODE" != "000" ] && [ -n "$CODE" ] && break
            sleep 2
          done
          echo "GET / -> HTTP $CODE"
          ICS=$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/public/{% endraw %}{{ calendar_filename }}{% raw %} || true)
          echo "GET /public/{% endraw %}{{ calendar_filename }}{% raw %} -> HTTP $ICS"
          docker logs smoke
          docker rm -f smoke >/dev/null
          # Kein 200 auf / erwarten: unangemeldet ist 401 die gesunde Antwort.
          case "$CODE" in
            ''|000) echo "::error::server never answered"; exit 1 ;;
            *) echo "smoke test passed (HTTP $CODE)" ;;
          esac
          [ "$ICS" = "200" ] || {
            echo "::error::/public/{% endraw %}{{ calendar_filename }}{% raw %} returned $ICS, expected 200 (Kalender-Abos)"; exit 1; }

      - name: Build and push digest
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          platforms: ${{ env.PLATFORM }}
          outputs: type=image,name=${{ env.IMAGE }},push-by-digest=true,name-canonical=true

      - name: Compute tag
        id: tag
        run: echo "tag=$(date -u +%Y%m%d%H%M%S)" >> "$GITHUB_OUTPUT"

      - name: Create and push manifest
        run: |
          docker buildx imagetools create \
            -t ${{ env.IMAGE }}:${{ steps.tag.outputs.tag }} \
            -t ${{ env.IMAGE }}:${{ github.sha }} \
            -t ${{ env.IMAGE }}:latest \
            ${{ env.IMAGE }}@${{ steps.build.outputs.digest }}

      - name: Install kustomize
        run: |
          curl -sSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv5.4.3/kustomize_v5.4.3_linux_${ARCH}.tar.gz" \
            | sudo tar xz -C /usr/local/bin
          kustomize version

      - name: Pin overlay to the freshly built :<sha> image
        working-directory: deploy/overlays/production
        run: |
          kustomize edit set image ${{ env.IMAGE }}=${{ env.IMAGE }}:${{ github.sha }}
          kustomize build . > /dev/null # ein kaputtes Overlay darf nie auf production landen
          git --no-pager diff -- kustomization.yaml

      # Eigener Branch statt Commit auf main: der Bot schreibt nicht in den Arbeitsbranch und löst keinen neuen Lauf aus.
      - name: Publish pinned overlay to the GitOps 'production' branch
        run: |
          git config user.name  "deploy-bot"
          git config user.email "deploy-bot@users.noreply.github.com"
          git add deploy/overlays/production/kustomization.yaml
          git commit -m "chore(deploy): roll to ${{ github.sha }}"
          # Voller Refname, sonst legt der allererste Push den Branch nicht an.
          git push --force origin HEAD:refs/heads/production

      - name: Report the deployed tag
        run: |
          {
            echo "### Auf \`production\` veroeffentlicht"
            echo
            echo '```'
            echo "${IMAGE}:${{ github.sha }}"
            echo "${IMAGE}:${{ steps.tag.outputs.tag }}"
            echo '```'
            echo
            echo "Argo CD zieht den Branch \`production\` und rollt aus."
          } >> "$GITHUB_STEP_SUMMARY"
{% endraw %}
