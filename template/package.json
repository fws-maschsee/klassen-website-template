{
	"name": "klassen-website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"start": "tsx server.ts",
		"preview": "astro preview",
		"typecheck": "astro check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:playwright": "playwright test",
		"authz:up": "node tests/e2e/authz/stack.mjs up",
		"authz:down": "node tests/e2e/authz/stack.mjs down",
		"authz:logs": "node tests/e2e/authz/stack.mjs logs",
		"test:e2e:authz": "playwright test --config=playwright.authz.config.ts",
		"db:migrate": "dbmate up",
		"db:status": "dbmate status",
		"db:new": "dbmate new",
		"check": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/node": "^9.0.0",
		"@astrojs/tailwind": "^6.0.2",
		"@levino/shipyard-base": "0.6.1",
		"@levino/shipyard-blog": "0.6.1",
		"@levino/shipyard-docs": "0.6.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tailwindcss/typography": "^0.5.15",
		"astro": "^5.16.0",
		"better-sqlite3": "^12.11.1",
		"daisyui": "^4.12.0",
		"dbmate": "^2.34.1",
		"express": "^5.2.1",
		"jose": "^6.2.8",
		"mailparser": "^3.9.14",
		"mjml": "^4.18.0",
		"nodemailer": "^9.0.4",
		"tailwindcss": "^3.4.0",
		"tsx": "^4.23.5",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@playwright/test": "^1.57.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/mailparser": "^3.4.6",
		"@types/mjml": "^5.0.0",
		"@types/node": "^22.20.1",
		"@types/nodemailer": "^8.0.1",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=20.0"
	}
}
