{
	"name": "klassen-website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"start": "tsx server.ts",
		"preview": "astro preview",
		"typecheck": "astro check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:playwright": "playwright test",
		"authz:up": "node tests/e2e/authz/stack.mjs up",
		"authz:down": "node tests/e2e/authz/stack.mjs down",
		"authz:logs": "node tests/e2e/authz/stack.mjs logs",
		"test:e2e:authz": "playwright test --config=playwright.authz.config.ts",
		"db:migrate": "dbmate up",
		"db:status": "dbmate status",
		"db:new": "dbmate new",
		"check": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/node": "^11.1.9",
		"@levino/shipyard-base": "0.9.4",
		"@levino/shipyard-blog": "0.9.4",
		"@levino/shipyard-docs": "0.9.4",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.2",
		"better-sqlite3": "^12.11.1",
		"daisyui": "^5.7.50",
		"dbmate": "^2.34.1",
		"express": "^5.2.1",
		"jose": "^6.2.8",
		"mailparser": "^3.9.14",
		"mjml": "^5.0.0",
		"nodemailer": "^10.0.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.5",
		"unist-util-visit": "^5.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "^1.57.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/mailparser": "^3.4.6",
		"@types/mjml": "^5.0.0",
		"@types/node": "^22.20.1",
		"@types/nodemailer": "^8.0.1",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.23.4"
	}
}
