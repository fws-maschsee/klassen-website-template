# Kubernetes-Manifeste dieser Klassenseite.
#
# Diese Dateien werden NICHT aus diesem Repository heraus deployt. Sie gehören
# nach `apps/{{ repo_name }}/` im GitOps-Repository
# https://github.com/{{ gitops_repo }} - siehe deploy/README.md.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ repo_name }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ repo_name }}
  namespace: {{ repo_name }}
spec:
  replicas: 1
  # revisionHistoryLimit: 0, weil alte ReplicaSets ihre Image-Schichten auf
  # einem Einzelknoten mit einer Platte festhalten und den Knoten in
  # DiskPressure treiben.
  revisionHistoryLimit: 0
  progressDeadlineSeconds: 120
  selector:
    matchLabels:
      app: {{ repo_name }}
  template:
    metadata:
      labels:
        app: {{ repo_name }}
    spec:
      containers:
        - name: app
          # Ohne Tag: Der Tag wird in kustomization.yaml über `images:`
          # festgeschrieben. Das ist die eine Zeile, die ein Rollout ändert.
          #
          # Das GHCR-Paket ist PRIVAT und muss privat bleiben - die Inhalte
          # sind in das Image kompiliert. Es gibt hier bewusst KEIN
          # imagePullSecret: Die Zugangsdaten für das Register liegen
          # knotenweit in /etc/rancher/k3s/registries.yaml. Ein CI-Token
          # taugt dafür nicht, es läuft mit dem Workflow ab und die Pods
          # landen Wochen später in ImagePullBackOff.
          image: ghcr.io/{{ github_org }}/{{ repo_name }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          env:
            # @astrojs/node standalone liest HOST/PORT; :: bindet dual-stack.
            - name: HOST
              value: "::"
            - name: PORT
              value: "3000"
          resources:
            requests:
              cpu: 50m
              memory: 192Mi
            limits:
              # Kein CPU-Limit: CPU ist komprimierbar, ein Limit bringt auf
              # einem Einzelknoten nur Throttling-Latenz. Speicher ist nicht
              # komprimierbar und wird deshalb sehr wohl gedeckelt.
              memory: 512Mi
          # Die App antwortet unangemeldeten Anfragen mit 401 - das ist eine
          # gesunde Antwort. httpGet würde 401 als Fehler werten, deshalb ein
          # TCP-Probe: Er beweist, dass der SSR-Server lauscht.
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          # Genau diese Kombination prüft der Smoke-Test im Deploy-Workflow
          # (--user 1000:1000 --read-only --tmpfs /tmp). Wer hier etwas
          # verschärft, muss den Smoke-Test mitziehen.
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 64Mi
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
---
apiVersion: v1
kind: Service
metadata:
  name: {{ repo_name }}
  namespace: {{ repo_name }}
spec:
  selector:
    app: {{ repo_name }}
  ports:
    - port: 80
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ repo_name }}
  namespace: {{ repo_name }}
  annotations:
    cert-manager.io/cluster-issuer: acme
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ site_domain }}
      secretName: {{ repo_name }}-tls
  rules:
    - host: {{ site_domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ repo_name }}
                port:
                  number: 80
