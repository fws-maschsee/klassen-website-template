apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - app.yaml
# Rollout = diesen Tag ändern und pushen; Argo CD gleicht ab.
#
# Der Deploy-Workflow dieses Repositories schreibt die Zeile NICHT selbst: Sein
# GITHUB_TOKEN kann nicht in ein anderes Repository committen. Der zu
# setzende Tag steht in der Zusammenfassung des Workflow-Laufs.
#
# `latest` steht hier nur als Startwert. Vor dem ersten echten Rollout durch
# einen Zeitstempel-Tag ersetzen - sonst weiß niemand, was gerade läuft, und
# `imagePullPolicy: IfNotPresent` zieht neue `latest`-Stände ohnehin nicht.
images:
  - name: ghcr.io/{{ github_org }}/{{ repo_name }}
    newTag: "latest"
