apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: {{ repo_name }}

resources:
  - deployment.yaml
  - service.yaml
  - ingress.yaml
  - sealed-oidc.yaml
  - sealed-mail.yaml
  - pvc.yaml

images:
  - name: ghcr.io/{{ github_org }}/{{ repo_name }}
    # Nie latest: nur ein unveränderlicher Tag sagt, welcher Stand läuft.
    newTag: "erster-deploy-ersetzt-diesen-wert"
