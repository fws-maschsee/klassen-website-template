---
# Gerüst: SealedSecrets gelten nur für einen Namespace und Cluster, Werte per kubeseal (deploy/README.md).
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  creationTimestamp: null
  name: {{ repo_name }}-oidc
  namespace: {{ repo_name }}
spec:
  encryptedData:
    OIDC_CLIENT_ID: PLATZHALTER-MIT-KUBESEAL-ERSETZEN
    OIDC_CLIENT_SECRET: PLATZHALTER-MIT-KUBESEAL-ERSETZEN
    SESSION_SECRET: PLATZHALTER-MIT-KUBESEAL-ERSETZEN
  template:
    metadata:
      creationTimestamp: null
      name: {{ repo_name }}-oidc
      namespace: {{ repo_name }}
    type: Opaque
