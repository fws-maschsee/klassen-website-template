apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ repo_name }}
  namespace: {{ repo_name }}
  annotations:
    cert-manager.io/cluster-issuer: acme
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ site_domain }}
      secretName: {{ repo_name }}-tls
  rules:
    - host: {{ site_domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ repo_name }}
                port:
                  number: 80
