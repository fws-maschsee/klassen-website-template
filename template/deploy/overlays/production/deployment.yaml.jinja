apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ repo_name }}
  namespace: {{ repo_name }}
spec:
  replicas: 1 # SQLite und die In-Prozess-Caches setzen genau eine Replik voraus
  revisionHistoryLimit: 0 # alte ReplicaSets halten Image-Layer auf der einzigen Node-Platte fest
  progressDeadlineSeconds: 120
  selector:
    matchLabels:
      app: {{ repo_name }}
  template:
    metadata:
      labels:
        app: {{ repo_name }}
    spec:
      containers:
        - name: app
          image: ghcr.io/{{ github_org }}/{{ repo_name }} # Tag pinnt kustomization.yaml
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: HOST
              value: "::" # dual-stack
            - name: PORT
              value: "3000"
            # Zeichengenau wie die redirect_uri am OIDC-Client; ohne den Wert meldet Astro hier localhost.
            - name: OIDC_PUBLIC_ORIGIN
              value: "https://{{ site_domain }}"
            # Aussteller des MCP-OAuth-Servers; MCP-Clients verwerfen Tokens, deren Aussteller nicht zeichengenau passt.
            - name: PUBLIC_BASE_URL
              value: "https://{{ site_domain }}"
            - name: ZITADEL_ORG_ID
              value: "{{ zitadel_org_id }}"
            - name: ZITADEL_PROJECT_ID
              value: "{{ zitadel_project_id }}"
          envFrom:
            - secretRef:
                name: {{ repo_name }}-oidc
            - secretRef:
                name: {{ repo_name }}-mail
            # Infrastruktur-Credential: von Hand im Cluster angelegt, deshalb kein SealedSecret im Repo.
            - secretRef:
                name: {{ repo_name }}-zitadel
          resources:
            requests:
              cpu: 50m
              memory: 192Mi
            limits: # bewusst ohne CPU-Limit: auf dem Single-Tenant-Node brächte es nur Throttling
              memory: 512Mi
          # TCP statt httpGet: unangemeldet antwortet / mit 302/401, und das ist gesund.
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: data
              mountPath: /data
      volumes:
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 64Mi
        - name: data
          persistentVolumeClaim:
            claimName: {{ repo_name }}-data
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000 # local-path legt das Volume als root an
