apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ repo_name }}
  namespace: {{ repo_name }}
spec:
  replicas: 1
  revisionHistoryLimit: 0
  progressDeadlineSeconds: 120
  selector:
    matchLabels:
      app: {{ repo_name }}
  template:
    metadata:
      labels:
        app: {{ repo_name }}
    spec:
      containers:
        - name: app
          image: ghcr.io/{{ github_org }}/{{ repo_name }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: HOST
              value: "::"
            - name: PORT
              value: "3000"
            - name: OIDC_PUBLIC_ORIGIN
              value: "https://{{ site_domain }}"
            - name: PUBLIC_BASE_URL
              value: "https://{{ site_domain }}"
            - name: ZITADEL_ORG_ID
              value: "{{ zitadel_org_id }}"
            - name: ZITADEL_PROJECT_ID
              value: "{{ zitadel_project_id }}"
          envFrom:
            - secretRef:
                name: {{ repo_name }}-oidc
            - secretRef:
                name: {{ repo_name }}-mail
            - secretRef:
                name: {{ repo_name }}-zitadel
          resources:
            requests:
              cpu: 50m
              memory: 192Mi
            limits:
              memory: 512Mi
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: data
              mountPath: /data
      volumes:
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 64Mi
        - name: data
          persistentVolumeClaim:
            claimName: {{ repo_name }}-data
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
