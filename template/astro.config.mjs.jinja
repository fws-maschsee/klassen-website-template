import node from '@astrojs/node'
import tailwind from '@astrojs/tailwind'
import shipyard from '@levino/shipyard-base'
import {
	remarkAdmonitions,
	remarkDirective,
} from '@levino/shipyard-base/remark'
import shipyardBlog from '@levino/shipyard-blog'
import shipyardDocs from '@levino/shipyard-docs'
import { defineConfig } from 'astro/config'
import { remarkAdmonitionLabels } from './plugins/remark-admonition-labels.mjs'
{% if plausible_script_url %}
import {
	ANALYTICS_SCRIPT_URL,
	CLASS_NAME,
	REPO_URL,
	SITE_DOMAIN,
	SITE_URL,
} from './src/site.config'
{% else %}
import { CLASS_NAME, REPO_URL, SITE_URL } from './src/site.config'
{% endif %}

export default defineConfig({
	site: SITE_URL,
	// SSR, weil ein statischer Build alle Berichte ohne Anmeldung ausliefern würde.
	output: 'server',
	adapter: node({
		// server.ts hängt Astro in Express ein, damit /mcp und die OAuth-Routen daneben laufen.
		mode: 'middleware',
	}),
	// Hinter Express greift der Origin-Check nicht zuverlässig; die Consent-Seite schützen PKCE und das zufällige pending_id.
	security: { checkOrigin: false },
	markdown: {
		// Reihenfolge ist bindend: das Label-Plugin muss zwischen Directive und Admonitions laufen.
		remarkPlugins: [remarkDirective, remarkAdmonitionLabels, remarkAdmonitions],
	},
	integrations: [
		tailwind({
			applyBaseStyles: false,
		}),
		shipyard({
			brand: CLASS_NAME,
			title: CLASS_NAME,
			tagline: 'Unterlagen und Berichte',
			navigation: {
				unterlagen: { label: 'Unterlagen', href: '/docs' },
				berichte: { label: 'Berichte', href: '/blog' },
				verteiler: { label: 'Mailverteiler', href: '/verteiler' },
				github: { label: 'GitHub', href: REPO_URL },
				verwaltung: { label: 'Verwaltung', href: '/verwaltung' },
				logout: { label: 'Abmelden', href: '/logout' },
			},
{% if plausible_script_url %}
			scripts: [
				{
					src: ANALYTICS_SCRIPT_URL,
					defer: true,
					// Die in Plausible angelegte Domain, nicht vom Klassennamen ableiten.
					'data-domain': SITE_DOMAIN,
				},
			],
{% endif %}
		}),
		shipyardDocs({
			editUrl: `${REPO_URL}/edit/main/src/content/docs`,
		}),
		shipyardBlog({
			blogTitle: 'Berichte',
			blogDescription: `Berichte und Protokolle der ${CLASS_NAME}`,
			authorsMapPath: './src/content/blog/authors.yml',
			postsPerPage: 20,
			editUrl: `${REPO_URL}/edit/main/src/content/blog`,
		}),
	],
})
