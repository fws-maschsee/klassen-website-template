---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import { listGroups } from '../../lib/db/groups.js'
import { instanceLabel } from '../../lib/db/instance.js'
import {
  listMailingLists,
  listPosterGroups,
  listRecipientGroups,
  listSenderPatterns,
  setListPosterRules,
} from '../../lib/db/mailingLists.js'
import {
  deleteMitglied,
  getMitgliedGroups,
  listMitglieder,
  upsertMitglied,
} from '../../lib/db/members.js'
import {
  listClientUsage,
  revokeAllTokensForClientAndUser,
} from '../../lib/db/oauth.js'
import type { PosterPolicy } from '../../lib/db/types.js'
import { listDomain } from '../../lib/email/config.js'
import {
  canEdit,
  canSeePersonalData,
  deniedMessage,
  ROLE_ADMIN,
  ROLE_MITGLIED,
} from '../../server/auth/roles.js'
import { publicBaseUrl } from '../../server/config.js'

export const prerender = false

const roles = Astro.locals.user?.roles ?? []
const mayEdit = canEdit(roles)
const maySeePersons = canSeePersonalData(roles)
const userId = Astro.locals.user?.sub ?? ''

let notice: { kind: 'ok' | 'error'; text: string } | null = null

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = String(form.get('action') ?? '')
  const text = (name: string): string => String(form.get(name) ?? '').trim()

  // Vor der mayEdit-Prüfung: den Widerruf der eigenen Vollmacht darf jeder.
  if (action === 'revoke') {
    const clientId = text('client_id')
    const { access, refresh } = revokeAllTokensForClientAndUser(
      clientId,
      userId,
    )
    notice = {
      kind: 'ok',
      text: `Zugriff beendet: ${access} Zugriffs- und ${refresh} Erneuerungs-Token widerrufen. Die Anwendung muss sich neu autorisieren.`,
    }
  } else if (!mayEdit) {
    // Serverseitig prüfen, nicht nur Formulare ausblenden: ein POST kommt auch ohne sie an.
    return new Response(deniedMessage('bearbeiten'), {
      status: 403,
      headers: { 'Content-Type': 'text/plain; charset=utf-8' },
    })
  } else {
    try {
      if (action === 'upsert') {
        const row = upsertMitglied({
          id: text('id') || undefined,
          first_name: text('first_name'),
          last_name: text('last_name'),
          email: text('email') || null,
          groups: form.getAll('groups').map(String),
        })
        notice = {
          kind: 'ok',
          text: `Gespeichert: ${row.first_name} ${row.last_name} (${row.id})`,
        }
      } else if (action === 'poster_rules') {
        const patterns = text('sender_patterns')
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter((line) => line.length > 0)
        const policy: PosterPolicy =
          text('poster_policy') === 'offen' ? 'offen' : 'eingeschraenkt'
        const list = setListPosterRules(text('address'), policy, patterns)
        notice = {
          kind: 'ok',
          text:
            list.poster_policy === 'offen'
              ? `Liste „${list.label}“: jede Absenderadresse darf jetzt schreiben.`
              : `Liste „${list.label}“: eingeschränkt, ${listSenderPatterns(list).length} Muster gespeichert.`,
        }
      } else if (action === 'delete') {
        const id = text('id')
        notice = deleteMitglied(id)
          ? { kind: 'ok', text: `Eintrag ${id} geloescht.` }
          : { kind: 'error', text: `Eintrag ${id} existierte nicht.` }
      }
    } catch (error) {
      notice = { kind: 'error', text: (error as Error).message }
    }
  }
}

// Personenbezogenes gar nicht erst laden, wenn es niemand sehen darf.
const mitglieder = maySeePersons
  ? listMitglieder().map((row) => ({ ...row, groups: getMitgliedGroups(row.id) }))
  : []
const groups = listGroups()
const lists = listMailingLists()
const clients = userId ? listClientUsage(userId) : []
const mcpUrl = `${publicBaseUrl()}/mcp`
const editId = new URL(Astro.request.url).searchParams.get('bearbeiten')
const editing = editId ? mitglieder.find((m) => m.id === editId) : undefined
const listId = new URL(Astro.request.url).searchParams.get('liste')
const editingList = listId ? lists.find((l) => l.address === listId) : undefined
---

<Layout title="Verwaltung">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-2">Verwaltung — {instanceLabel()}</h1>

    <p class="mb-6">
      {mayEdit ? (
        <>Du hast die Rolle <code>{ROLE_ADMIN}</code> und darfst Adressbuch,
        Gruppen und Verteiler pflegen.</>
      ) : (
        <>Du hast die Rolle <code>{ROLE_MITGLIED}</code>. Du siehst, welche
        Verteiler es gibt und welche Gruppen sie erreichen. Wer im Einzelnen
        auf einer Liste steht, sehen nur Zugänge mit der Rolle
        <code>{ROLE_ADMIN}</code> — das sind die Adressen anderer Familien.</>
      )}
    </p>

    {notice && (
      <p class={`not-prose mb-6 rounded p-3 ${notice.kind === 'ok' ? 'bg-success/20' : 'bg-error/20'}`}>
        {notice.text}
      </p>
    )}

    <h2 class="text-xl font-bold mt-8 mb-3">Mailinglisten ({lists.length})</h2>
    <p class="mb-3">
      Eine Mail an eine dieser Adressen erreicht alle Personen der genannten
      Gruppen. Wer an eine Liste senden <em>darf</em>, steht in der Spalte
      „Absender".
    </p>
    <div class="not-prose overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Adresse</th><th>Bezeichnung</th><th>Erreicht</th>
            <th>Wer darf senden</th><th>Antwort an</th><th>Aktiv</th>
            {mayEdit && <th></th>}
          </tr>
        </thead>
        <tbody>
          {lists.map((l) => (
            <tr>
              <td class="font-mono text-xs whitespace-nowrap">{l.address}@{listDomain()}</td>
              <td>{l.label}</td>
              <td class="text-xs">{listRecipientGroups(l).join(', ') || '—'}</td>
              <td class="text-xs">
                {l.poster_policy === 'offen' ? (
                  <strong>alle — auch von außerhalb</strong>
                ) : (
                  [
                    ...listPosterGroups(l),
                    ...(l.broadcast ? ['alle Empfänger'] : []),
                    ...listSenderPatterns(l),
                  ].join(', ') || 'niemand'
                )}
              </td>
              <td class="text-xs">{l.reply_mode === 'list' ? 'die Liste' : 'den Absender'}</td>
              <td>{l.aktiv ? 'ja' : 'nein'}</td>
              {mayEdit && (
                <td class="whitespace-nowrap">
                  <a class="link link-primary text-xs" href={`/verwaltung?liste=${encodeURIComponent(l.address)}`}>Absenderrecht</a>
                </td>
              )}
            </tr>
          ))}
          {lists.length === 0 && (
            <tr><td colspan={mayEdit ? 7 : 6}>Noch keine Verteiler angelegt.</td></tr>
          )}
        </tbody>
      </table>
    </div>

    {mayEdit && editingList && (
      <>
        <h3 class="text-lg font-bold mt-6 mb-3">
          Absenderrecht: {editingList.label} ({editingList.address}@{listDomain()})
        </h3>
        <form method="POST" class="not-prose grid gap-3 max-w-xl">
          <input type="hidden" name="action" value="poster_rules" />
          <input type="hidden" name="address" value={editingList.address} />

          <label class="flex items-start gap-2">
            <input type="radio" class="radio radio-sm mt-1" name="poster_policy" value="offen"
              checked={editingList.poster_policy === 'offen'} />
            <span>
              <strong>Offen</strong> — jede Absenderadresse darf an diese Liste
              schreiben.
              <span class="block text-sm opacity-70">
                Das heißt wörtlich: jede E-Mail-Adresse der Welt kann eine
                Nachricht an alle Familien dieser Liste schicken. Bequem für
                den Alltag, weil niemand vorher eingetragen werden muss —
                offen ist aber auch für Werbung und Betrugsversuche.
              </span>
            </span>
          </label>

          <label class="flex items-start gap-2">
            <input type="radio" class="radio radio-sm mt-1" name="poster_policy" value="eingeschraenkt"
              checked={editingList.poster_policy !== 'offen'} />
            <span>
              <strong>Eingeschränkt</strong> — nur die Absendergruppen der
              Liste und die Muster unten.
            </span>
          </label>

          <label class="form-control">
            <span class="label-text">Erlaubte Absender (ein Muster je Zeile)</span>
            <textarea class="textarea textarea-bordered font-mono text-sm" name="sender_patterns" rows="4"
              >{listSenderPatterns(editingList).join('\n')}</textarea>
            <span class="label-text-alt mt-1 opacity-70">
              Volle Adresse (<code>anna@example.org</code>) oder ganze Domain
              (<code>*@schule.example</code>). Der Stern steht nur
              ganz vorne. Die Domain muss genau stimmen:
              <code>*@example.org</code> erlaubt <em>nicht</em>
              <code>anna@mail.example.org</code>. Groß- und Kleinschreibung
              ist egal. Bei „Offen" spielen die Muster keine Rolle.
            </span>
          </label>

          <div class="flex gap-3">
            <button type="submit" class="btn btn-primary">Speichern</button>
            <a class="btn btn-ghost" href="/verwaltung">Abbrechen</a>
          </div>
        </form>
        <p class="text-sm opacity-70 mt-2 mb-6">
          Geprüft wird die Absenderadresse aus dem SMTP-Umschlag, nicht der
          <code>Von:</code>-Text in der Mail — nur der Umschlag lässt sich
          gegen SPF prüfen. Empfänger, Gruppen und die übrigen Einstellungen
          der Liste laufen weiterhin über MCP
          (<code>upsert_mailing_list</code>).
        </p>
      </>
    )}

    <h2 class="text-xl font-bold mt-8 mb-3">Gruppen ({groups.length})</h2>
    <p class="mb-3">
      Gruppen sind das, worauf Verteiler zeigen. „Effektiv" zählt die
      Untergruppen mit — eine Obergruppe erreicht automatisch alle, die in
      ihren Untergruppen stehen.
    </p>
    <div class="not-prose overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Key</th><th>Bezeichnung</th><th>Direkt</th>
            <th>Effektiv</th><th>Untergruppen</th><th>Aktiv</th>
          </tr>
        </thead>
        <tbody>
          {groups.map((g) => (
            <tr>
              <td class="font-mono text-xs">{g.key}</td>
              <td>{g.label}</td>
              <td>{g.mitglieder}</td>
              <td>{g.mitglieder_effektiv}</td>
              <td class="text-xs">{g.children.join(', ') || '—'}</td>
              <td>{g.aktiv ? 'ja' : 'nein'}</td>
            </tr>
          ))}
          {groups.length === 0 && (
            <tr><td colspan="6">Noch keine Gruppen angelegt.</td></tr>
          )}
        </tbody>
      </table>
    </div>

    <h2 class="text-xl font-bold mt-8 mb-3">Mit Claude verbinden (MCP)</h2>
    <p class="mb-3">
      Diese Instanz bietet ihre Verwaltung zusätzlich als <strong>MCP-Server</strong>
      an. In Claude (oder einem anderen MCP-Client) als Server eintragen —
      danach lässt sich die Klassenliste im Gespräch pflegen, statt Formulare
      auszufüllen. Die Anmeldung läuft automatisch: der Client registriert sich
      selbst und schickt Dich hierher zur Zustimmung.
    </p>
    <div class="not-prose mb-3">
      <label class="label-text" for="mcp-url">Server-URL</label>
      <div class="flex gap-2 items-center">
        <input
          id="mcp-url"
          class="input input-bordered font-mono text-sm flex-1"
          readonly
          value={mcpUrl}
        />
        <button type="button" class="btn" data-copy={mcpUrl}>Kopieren</button>
      </div>
    </div>
    <p class="text-sm opacity-70 mb-6">
      Ein Zugang mit <code>{ROLE_MITGLIED}</code> kann über MCP die Verteiler
      und Gruppen abfragen. Namen und Adressen liefern die Werkzeuge nur an
      Zugänge mit <code>{ROLE_ADMIN}</code> — dieselbe Grenze wie auf dieser
      Seite, geprüft an derselben Stelle.
    </p>

    <h3 class="text-lg font-bold mt-6 mb-3">Verbundene Anwendungen</h3>
    <div class="not-prose overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr><th>Anwendung</th><th>Aktive Zugriffe</th><th>Zuletzt</th><th></th></tr>
        </thead>
        <tbody>
          {clients.map((c) => (
            <tr>
              <td>
                {c.client_name}
                <span class="block text-xs opacity-50 font-mono">{c.client_id}</span>
              </td>
              <td>{c.active_access_tokens} / {c.active_refresh_tokens}</td>
              <td class="text-xs">{c.last_token_at ?? '—'}</td>
              <td>
                <form method="POST" data-confirm={`Zugriff der Anwendung „${c.client_name}“ wirklich beenden? Alle ihre Token werden ungültig, sie muss neu verbunden werden.`}>
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="client_id" value={c.client_id} />
                  <button type="submit" class="btn btn-sm btn-error">Zugriff beenden</button>
                </form>
              </td>
            </tr>
          ))}
          {clients.length === 0 && (
            <tr><td colspan="4">Noch keine Anwendung verbunden.</td></tr>
          )}
        </tbody>
      </table>
    </div>
    <p class="text-sm opacity-70 mt-2 mb-6">
      „Zugriff beenden" widerruft alle Token dieser Anwendung — aber nur
      Deine. Andere Zugänge bleiben unberührt.
    </p>

    {maySeePersons ? (
      <>
        <h2 class="text-xl font-bold mt-8 mb-3">Adressbuch ({mitglieder.length})</h2>
        <div class="not-prose overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Name</th><th>E-Mail</th><th>Gruppen</th>{mayEdit && <th></th>}
              </tr>
            </thead>
            <tbody>
              {mitglieder.map((m) => (
                <tr>
                  <td>{m.last_name}, {m.first_name}</td>
                  <td class="font-mono text-xs">{m.email ?? '—'}</td>
                  <td class="text-xs">{m.groups.join(', ') || '—'}</td>
                  {mayEdit && (
                    <td class="whitespace-nowrap">
                      <a class="link link-primary text-xs" href={`/verwaltung?bearbeiten=${encodeURIComponent(m.id)}`}>bearbeiten</a>
                      <form method="POST" class="inline" data-confirm={`„${m.last_name}, ${m.first_name}“ wirklich aus dem Adressbuch löschen? Das lässt sich nicht rückgängig machen.`}>
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={m.id} />
                        <button type="submit" class="link link-error text-xs ml-2">löschen</button>
                      </form>
                    </td>
                  )}
                </tr>
              ))}
              {mitglieder.length === 0 && (
                <tr><td colspan={mayEdit ? 4 : 3}>Noch keine Einträge.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </>
    ) : (
      <>
        <h2 class="text-xl font-bold mt-8 mb-3">Adressbuch</h2>
        <p class="mb-6">
          Namen und E-Mail-Adressen der Familien sind
          personenbezogen. Sie sehen nur Zugänge mit der Rolle
          <code>{ROLE_ADMIN}</code> — auch über MCP.
        </p>
      </>
    )}

    {mayEdit && (
      <>
        <h2 class="text-xl font-bold mt-8 mb-3">
          {editing ? `Eintrag bearbeiten: ${editing.id}` : 'Eintrag anlegen'}
        </h2>
        <form method="POST" class="not-prose grid gap-3 max-w-xl">
          <input type="hidden" name="action" value="upsert" />
          <input type="hidden" name="id" value={editing?.id ?? ''} />
          <div class="grid grid-cols-2 gap-3">
            <label class="form-control">
              <span class="label-text">Vorname</span>
              <input class="input input-bordered" name="first_name" required value={editing?.first_name ?? ''} />
            </label>
            <label class="form-control">
              <span class="label-text">Nachname</span>
              <input class="input input-bordered" name="last_name" required value={editing?.last_name ?? ''} />
            </label>
          </div>
          <label class="form-control">
            <span class="label-text">E-Mail</span>
            <input class="input input-bordered" type="email" name="email" value={editing?.email ?? ''} />
          </label>
          <p class="text-sm opacity-70">
            Mehr als Name und E-Mail wird bewusst nicht gespeichert — keine
            Anrede, keine Telefonnummer, keine Notizen. Für den Versand
            reicht das, und was nicht da ist, kann auch nicht abhandenkommen.
          </p>
          <fieldset class="border rounded p-3">
            <legend class="label-text px-1">Gruppen</legend>
            {groups.map((g) => (
              <label class="flex items-center gap-2">
                <input type="checkbox" class="checkbox checkbox-sm" name="groups" value={g.key}
                  checked={editing?.groups.includes(g.key)} />
                <span>{g.label} <code class="text-xs">{g.key}</code></span>
              </label>
            ))}
            {groups.length === 0 && <p class="text-sm">Noch keine Gruppen — über MCP (<code>upsert_group</code>) anlegen.</p>}
          </fieldset>
          <div class="flex gap-3">
            <button type="submit" class="btn btn-primary">Speichern</button>
            {editing && <a class="btn btn-ghost" href="/verwaltung">Abbrechen</a>}
          </div>
        </form>
      </>
    )}
  </div>
</Layout>

<script>
  document.querySelectorAll('form[data-confirm]').forEach((form) => {
    // Am Formular statt am Knopf, damit die Rückfrage auch beim Absenden per Tastatur greift.
    form.addEventListener('submit', (event) => {
      const frage = form.getAttribute('data-confirm') ?? 'Wirklich fortfahren?'
      if (!window.confirm(frage)) event.preventDefault()
    })
  })

  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.getAttribute('data-copy') ?? ''
      try {
        await navigator.clipboard.writeText(value)
        const before = button.textContent
        button.textContent = 'Kopiert'
        setTimeout(() => {
          button.textContent = before
        }, 1500)
      } catch {
        const field = document.getElementById('mcp-url')
        if (field instanceof HTMLInputElement) field.select()
      }
    })
  })
</script>
