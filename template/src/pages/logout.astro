---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
---

<Layout title="Abmelden">
  <div class="container mx-auto px-4 py-12 max-w-md text-center">
    <h1 class="text-2xl font-bold mb-6">Abmelden</h1>
    <p class="mb-6">Möchtest du dich abmelden?</p>
    <form method="post" action="/auth/logout">
      <button type="submit" class="btn btn-error">Abmelden</button>
    </form>
  </div>
</Layout>
