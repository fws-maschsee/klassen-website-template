# Autor:innen der Berichte. Der Schlüssel ist der Kurzname, der im Frontmatter
# eines Berichts unter `authors:` benutzt wird.
#
# Achtung: Shipyard 0.6 löst diese Datei noch nicht auf. Bis dahin werden
# Autor:innen im Frontmatter als Objekte angegeben:
#
#     authors:
#       - name: Vorname Nachname
#
# Die Datei wird trotzdem gepflegt, damit die Angaben an einer Stelle stehen,
# sobald Shipyard sie auswertet.
kontakt:
  name: Kontakt
  url: mailto:{{ contact_email }}
