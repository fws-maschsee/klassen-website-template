import Database, { type Database as DatabaseType } from 'better-sqlite3'

let cached: DatabaseType | null = null

export const DEFAULT_DB_PATH = './data/{{ repo_name }}.db'

export const dbPath = (): string => process.env.DB_PATH ?? DEFAULT_DB_PATH

export const openDb = (path?: string): DatabaseType => {
	if (cached) return cached
	const db = new Database(path ?? dbPath())
	db.pragma('journal_mode = WAL')
	db.pragma('foreign_keys = ON')
	db.pragma('synchronous = NORMAL')
	cached = db
	return db
}

export const closeDb = (): void => {
	if (cached) {
		cached.close()
		cached = null
	}
}
