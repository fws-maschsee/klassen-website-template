import { chromium } from 'playwright'

const BASE = process.env.BASE
const LOGIN = process.env.LOGIN_NAME
const PASSWORD = process.env.PASSWORD
const EXPECT = process.env.EXPECT || '200'
const ISSUER = (process.env.ISSUER || '{{ oidc_issuer }}').replace(
	/\/+$/,
	'',
)

const log = (...a) => console.log(...a)

const browser = await chromium.launch()
const context = await browser.newContext({ ignoreHTTPSErrors: false })
const page = await context.newPage()

const trail = []
page.on('response', (r) => {
	if (r.request().resourceType() === 'document') {
		trail.push(`${r.status()} ${r.url().split('?')[0]}`)
	}
})

let failed = false
try {
	log(`\n--- 1. ${BASE}/ ohne Anmeldung aufrufen`)
	const first = await page.goto(`${BASE}/`, { waitUntil: 'domcontentloaded' })
	log('landete auf:', page.url().split('?')[0], '->', first.status())
	if (!page.url().startsWith(`${ISSUER}/ui/v2/login`)) {
		throw new Error(
			`erwartet wurde die Login-v2-Oberflaeche, tatsaechlich: ${page.url()}`,
		)
	}
	log('OK: Umleitung in die Login-v2-Oberflaeche')

	log('\n--- 2. Benutzername eingeben')
	const userField = page.getByTestId('username-text-input')
	await userField.waitFor({ timeout: 20000 })
	await userField.pressSequentially(LOGIN, { delay: 15 })
	let typed = await userField.inputValue()
	if (typed !== LOGIN) {
		log(`  Eingabe unvollstaendig (${typed}) — noch einmal`)
		await userField.fill('')
		await userField.pressSequentially(LOGIN, { delay: 60 })
		typed = await userField.inputValue()
	}
	log('  Eingabe:', typed)
	const next = page.getByTestId('submit-button')
	await next.waitFor({ state: 'visible' })
	await page.waitForFunction(
		() => !document.querySelector('[data-testid=submit-button]')?.disabled,
		null,
		{ timeout: 20000 },
	)
	await next.click()
	await page.waitForURL(/\/ui\/v2\/login\/password/, { timeout: 30000 })

	log('\n--- 3. Passwort eingeben')
	const pwField = page.locator('input[type="password"]').first()
	await pwField.waitFor({ timeout: 20000 })
	await pwField.pressSequentially(PASSWORD, { delay: 15 })
	await page.getByTestId('submit-button').click()

	log('\n--- 4. Rueckkehr in die App abwarten')
	await page.waitForURL((u) => u.toString().startsWith(BASE), {
		timeout: 30000,
	})
	await page.waitForLoadState('networkidle', { timeout: 30000 }).catch(() => {})
	log('landete auf:', page.url())

	const finalResponse = await page.request.get(`${BASE}/`, { maxRedirects: 0 })
	const status = finalResponse.status()
	const body = await page.content()
	log('\n--- 5. Ergebnis')
	log('HTTP', status, 'auf', `${BASE}/`)
	log('Titel:', await page.title())
	const h1 = await page
		.locator('h1')
		.first()
		.textContent()
		.catch(() => null)
	log('h1:', h1)

	if (String(status) !== EXPECT) {
		throw new Error(`erwartet HTTP ${EXPECT}, bekommen ${status}`)
	}
	log(`\nOK: erwarteter Status ${EXPECT}`)
	if (EXPECT === '200') {
		if (!/Willkommen/.test(body)) throw new Error('geschuetzter Inhalt fehlt')
		log('OK: geschuetzter Inhalt wird ausgeliefert')
	}
	if (EXPECT === '403') {
		if (!/noch nicht freigeschaltet/.test(body)) {
			throw new Error('erwartete Hinweisseite fehlt')
		}
		log('OK: verstaendliche Hinweisseite statt Rohfehler')
	}
} catch (error) {
	failed = true
	log('\nFEHLGESCHLAGEN:', error.message)
	log('Seiten-Trail:', trail.join('\n  '))
	log('aktuelle URL:', page.url())
	log(
		'Seitentext:',
		(
			await page
				.locator('body')
				.innerText()
				.catch(() => '')
		)
			.replace(/\n{2,}/g, '\n')
			.slice(0, 800),
	)
} finally {
	await browser.close()
}
process.exit(failed ? 1 : 0)
