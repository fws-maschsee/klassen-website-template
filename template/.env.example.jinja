# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (ist gitignored).
# Auf dem Server werden dieselben Werte als Umgebungsvariablen gesetzt.

# ---------------------------------------------------------------------------
# Instanz-Identität — EIN Deployment PRO KLASSE
# ---------------------------------------------------------------------------
# Muss zu dem Namen passen, der in der SQLite-Datei hinterlegt ist
# (app_meta.instance). Passt beides nicht zusammen, startet der Server gar
# nicht — das ist Absicht: sonst geht der nächste Versand an die falsche Klasse.
MCP_INSTANCE_NAME={{ repo_name }}
MCP_INSTANCE_LABEL={{ class_display_name }}

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# DB_PATH liest die Anwendung, DATABASE_URL liest dbmate (Migrations).
# Beide müssen auf dieselbe Datei zeigen. Im Container: /data/{{ repo_name }}.db
DB_PATH=./data/{{ repo_name }}.db
DATABASE_URL=sqlite:./data/{{ repo_name }}.db

# ---------------------------------------------------------------------------
# Öffentliche Adresse (OAuth-Issuer für den MCP-Endpunkt)
# ---------------------------------------------------------------------------
# Muss exakt der Adresse entsprechen, unter der die Instanz erreichbar ist.
PUBLIC_BASE_URL=http://localhost:4321
PORT=4321

# ---------------------------------------------------------------------------
# Versand über Amazon SES (SMTP-Interface)
# ---------------------------------------------------------------------------
# PORT 2587 IST ABSICHT und darf nicht "vereinheitlicht" werden: 25, 465 und
# 587 waren zwischenzeitlich providerseitig blockiert, 2587 funktioniert
# unabhängig davon.
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_PORT=2587
# SES-SMTP-Credentials, NICHT die IAM-Access-Keys.
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Verifizierte Absenderadresse.
MAIL_FROM={{ mail_from }}
MAIL_FROM_NAME={{ class_display_name }}
# Antwortadresse für Rundmails. Ohne Wert wird MAIL_FROM genommen.
MAIL_REPLY_TO=

# Drosselung: maximal so viele Mails pro Stunde über beide Warteschlangen
# zusammen (Rundmails + Mailinglisten).
MAIL_HOURLY_CAP=250
MAIL_PARALLEL_BURST=25

# ---------------------------------------------------------------------------
# Mailinglisten
# ---------------------------------------------------------------------------
# Vollständige Listen-Domain INKLUSIVE Klassen-Label. Eine Liste `eltern` ist
# damit eltern@{{ repo_name }}.{{ list_base_domain }} — genau die Adresse, für
# die der Worker das Routing hat (dort heißt die Variable LIST_DOMAIN und
# enthält nur `{{ list_base_domain }}`, das Klassen-Label kommt aus
# CLASS_SLUG). Ohne Wert leitet die App sie aus MCP_INSTANCE_NAME ab.
LIST_DOMAIN={{ repo_name }}.{{ list_base_domain }}
# Envelope-Absender (Return-Path) der weiterverteilten Mails. Ohne Wert:
# MAIL_FROM.
LIST_ENVELOPE_FROM=

# Geteiltes Geheimnis zwischen Cloudflare-Email-Worker und dieser App. Muss auf
# beiden Seiten identisch sein. Im Worker wird es NICHT mit `wrangler secret
# put` gesetzt: Der Worker wird nie von Hand ausgerollt. Erst einen Build aus
# `main` über die GitHub-Integration laufen lassen, dann das Secret im
# Cloudflare-Dashboard eintragen.
# Ohne diesen Wert weist die App JEDE eingehende Listenmail mit 401 ab.
LIST_WEBHOOK_SECRET=

# Eigenes Größenlimit für eingehende Listenmail (Bytes). Zweite
# Verteidigungslinie hinter MAX_MESSAGE_BYTES im Worker. Default 10 MiB.
MAX_MESSAGE_BYTES=10485760

# ---------------------------------------------------------------------------
# Anmeldung (OIDC gegen das zentrale ZITADEL der Schule)
# ---------------------------------------------------------------------------
AUTH_PROVIDER=zitadel
OIDC_ISSUER={{ oidc_issuer }}
# Leserolle im ZITADEL-Projekt dieser Klasse. Muss zu AUTH_ROLE in
# src/site.config.ts passen.
OIDC_REQUIRED_ROLE=mitglied
# Zeichengenau die Adresse, unter der die Instanz erreichbar ist. Sie muss zu
# der redirect_uri am OIDC-Client passen (dort: <origin>/auth/callback).
OIDC_PUBLIC_ORIGIN=http://localhost:4321

# Zugangsdaten des OIDC-Clients dieser Klasse. Im Cluster kommen sie aus dem
# SealedSecret `{{ repo_name }}-oidc`; lokal hier eintragen. Fehlen sie,
# antwortet die App auf geschützten Pfaden mit 503 statt ungeschützt zu laufen.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Schlüssel, mit dem das Sitzungs-Cookie verschlüsselt wird.
SESSION_SECRET=

# Organisation und Projekt in ZITADEL. Werden gebraucht, um die Rollen-Grants
# der Eltern zu lesen (Adressbuch-Abgleich, src/server/auth/grants.ts).
ZITADEL_ORG_ID={{ zitadel_org_id }}
ZITADEL_PROJECT_ID={{ zitadel_project_id }}
# PAT eines NUR LESENDEN Machine-Users. Infrastruktur-Credential: gehört weder
# ins Repository noch in ein SealedSecret, sondern wird von Hand als Secret
# `{{ repo_name }}-zitadel` im Cluster angelegt.
ZITADEL_SERVICE_TOKEN=
